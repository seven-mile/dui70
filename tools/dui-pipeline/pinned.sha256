068da6ad1ffa42d501e3db84d311ec50e9894d146cb018ad2dc258b3174ee652  manifest.json
f2fc84d52d6811a05b03f8676c01628db2366a764a7ea5ddf3877330b87fbfca  mi-interface-lengths.json
51344c07c335c3e8f6fa6e325a6e95ab6d8349231b1922fbe93fabeaab6ec0d9  mi-tables.json
