ad2f32fd9622a9b1735d7d3af11a8d4230a540c5843714e67026d5c108b6b8e2  mi-tables.json
64b95520a847e2564a2548e96c900087bc6e3de7ccdb5c5494a21e97885a7fc8  symbols.json
